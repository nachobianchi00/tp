NODE_ENV=development
# Completar solo en back/.env.local con la URL de tu MySQL local propia.
# Formato: mysql://<usuario>:<clave>@127.0.0.1:<puerto>/<base_propia>
DATABASE_URL=
# Generar un secreto aleatorio de al menos 32 bytes.
SESSION_SECRET=
CSRF_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
